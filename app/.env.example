# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local to source control.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Secret User Token sent as x-user-token header to satisfy database RLS (is_app_authorized)
# Prevents unauthorized internet bots & web crawlers from reading or mutating records
VITE_USER_API_TOKEN=kasab_secure_prod_token_2026

# Operator PIN used for app unlocking and x-app-pin header verification
VITE_MASTER_PIN=7878

# Gemini AI Vision Configuration (Optional for Smart Challan Scanner)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
